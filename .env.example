# =============================================================================
# MariaDB MCP Server 환경 변수 템플릿
# 로컬 테스트: cp .env.example .env
# 프로덕션: cp .env.example .env.production (deploy 스크립트가 서버에 .env로 복사)
# docker --env-file은 따옴표를 리터럴로 포함시키므로 따옴표 사용 금지
#
# instances.json으로 멀티 인스턴스 관리 (단일 인스턴스는 DB_* 변수 사용)
# =============================================================================

# ── 시스템 ────────────────────────────────────────────
# 타임존 (대한민국 표준시)
TZ=Asia/Seoul

# 로케일 (UTF-8 인코딩 보장)
LANG=C.UTF-8

# ── DB (단일 인스턴스 모드) ───────────────────────────
# instances.json 존재 시 무시됨
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
#DB_CHARSET=utf8mb4

# ── DB SSL ────────────────────────────────────────────
#DB_SSL=false
#DB_SSL_CA=
#DB_SSL_CERT=
#DB_SSL_KEY=
#DB_SSL_VERIFY_CERT=true
#DB_SSL_VERIFY_IDENTITY=false

# ── MCP 서버 ─────────────────────────────────────────
#MCP_READ_ONLY=true
#MCP_MAX_POOL_SIZE=10

# ── CORS / Host Filtering ────────────────────────────
#ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://*,https://localhost,https://127.0.0.1,vscode-file://vscode-app
#ALLOWED_HOSTS=localhost,127.0.0.1

# ── Embedding ─────────────────────────────────────────
# Provider: openai, gemini, huggingface (빈 값이면 비활성)
#EMBEDDING_PROVIDER=
#OPENAI_API_KEY=
#OPENAI_BASE_URL=
#GEMINI_API_KEY=
#HF_MODEL=BAAI/bge-m3

# ── 로깅 ─────────────────────────────────────────────
#LOG_LEVEL=INFO
#LOG_FILE=logs/mcp_server.log
#LOG_MAX_BYTES=10485760
#LOG_BACKUP_COUNT=5
