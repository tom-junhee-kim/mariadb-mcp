# =============================================================================
# MariaDB MCP Server 환경 변수 템플릿
# 로컬 테스트: cp .env.example .env
# 프로덕션: cp .env.example .env.production (deploy 스크립트가 서버에 .env로 복사)
# docker --env-file은 따옴표를 리터럴로 포함시키므로 따옴표 사용 금지
# =============================================================================

# ── 시스템 ────────────────────────────────────────────
# 타임존 (대한민국 표준시)
TZ=Asia/Seoul


# --- Database Configuration (single-instance mode) ---
# Used when instances.json is not present.
# For multi-instance setup, use instances.json instead (see instances.example.json).
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# DB_CHARSET=utf8mb4

# --- SSL Configuration ---
# DB_SSL=false
# DB_SSL_CA=
# DB_SSL_CERT=
# DB_SSL_KEY=
# DB_SSL_VERIFY_CERT=true
# DB_SSL_VERIFY_IDENTITY=false

# --- MCP Server Configuration ---
# MCP_READ_ONLY=true
# MCP_MAX_POOL_SIZE=10

# --- CORS / Host Filtering ---
# Comma-separated lists. Defaults are localhost only.
# ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://*,https://localhost,https://127.0.0.1,vscode-file://vscode-app
# ALLOWED_HOSTS=localhost,127.0.0.1

# --- Embedding Configuration ---
# Provider: "openai", "gemini", "huggingface", or leave empty to disable
# EMBEDDING_PROVIDER=

# OpenAI embeddings
# OPENAI_API_KEY=
# OPENAI_BASE_URL=              # Custom base URL (e.g., local embedding server)

# Gemini embeddings
# GEMINI_API_KEY=

# HuggingFace embeddings
# HF_MODEL=BAAI/bge-m3

# --- Logging ---
# LOG_LEVEL=INFO
# LOG_FILE=logs/mcp_server.log
# LOG_MAX_BYTES=10485760        # 10MB
# LOG_BACKUP_COUNT=5
